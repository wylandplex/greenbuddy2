[Unit]
Description=GreenBuddy Schlaf-Stellvertreter: GDM zählen, schlafende Hosts übernehmen und wecken
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=gb-stellvertreter
Group=gb-stellvertreter
ExecStart=/usr/local/sbin/gb-stellvertreter --config /etc/greenbuddy/stellvertreter.json
# Entfernt Alias und nft-Tabellen auch nach SIGKILL (fehlende Artefakte = Erfolg).
ExecStopPost=/usr/local/sbin/gb-stellvertreter --aufraeumen --config /etc/greenbuddy/stellvertreter.json
Restart=on-failure
RestartSec=60
UMask=0077
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/run/greenbuddy/log /run/greenbuddy/stellvertreter /run/greenbuddy/status
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
LockPersonality=yes
RestrictRealtime=yes
# AF_PACKET: Raw-Sockets (eth0, wg0); AF_NETLINK: ip/nft; AF_UNIX: Namensauflösung über resolved.
RestrictAddressFamilies=AF_INET AF_UNIX AF_PACKET AF_NETLINK
MemoryMax=300M
TimeoutStopSec=15
KillMode=control-group

[Install]
WantedBy=multi-user.target
